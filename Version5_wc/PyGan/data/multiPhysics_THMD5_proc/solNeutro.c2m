* Procedure : Neutronics.c2m
* Purpose : Proceed to neutronics solution
* Required output : axial power solution for TH solution
* Author : R. Guasch, Adapted from PowComponent.c2m (A. Hébert)
* Date : 19/09/2024
* Modified on 09/06/2025 to get rid of THData LCM object dependency : 
* --> use parameters stored in Fmap for interpolation of XS.
* CALL      :                                                  
*  Fmap Matex Flux := Neutronics Fmap Matex Flux Cpo Track THData  
*    :: <<iter>> <<power>> ;


PARAMETER  Fmap Matex Flux Power Cpo Track ::
  ::: LINKED_LIST Fmap Matex Flux Power Cpo Track ; ;
INTEGER iter ;
 :: >>iter<< ;
DOUBLE Dpowi  ;
 :: >>Dpowi<< ;
INTEGER Nz ;
 :: >>Nz<< ;


MODULE NCR: MACINI: TRIVAA: FLUD: FLPOW: GREP: DELETE: END: ;
LINKED_LIST MacroF System Macro1 Macro2 MicroF ;

PROCEDURE 
InterpXS10 InterpXS20 InterpXS30 InterpXS40 InterpXS50 
InterpXS60 InterpXS70 InterpXS80 InterpXS90 InterpXS100
InterpXS110 InterpXS120 InterpXS130 InterpXS140 InterpXS150
InterpXS160 InterpXS170 InterpXS180 InterpXS190 InterpXS200 ;
REAL powi := Dpowi D_TO_R ;

REAL keff1 ;

STRING DIR := "EDIPARAM" ;

ECHO "+++ Neutronics calculation at iter = " iter ;
ECHO "+++ Power = " powi "MW" ;
ECHO "+++ Number of axial nodes = " Nz ;
*--
* Cross-section database interpolation
*--
IF Nz 10 = THEN
      MicroF := InterpXS10 Fmap Cpo :: <<Nz>> ;
ELSEIF Nz 20 = THEN
      MicroF := InterpXS20 Fmap Cpo :: <<Nz>> ;
ELSEIF Nz 30 = THEN
      MicroF := InterpXS30 Fmap Cpo :: <<Nz>> ;
ELSEIF Nz 40 = THEN
      MicroF := InterpXS40 Fmap Cpo :: <<Nz>> ;
ELSEIF Nz 50 = THEN     
      MicroF := InterpXS50 Fmap Cpo :: <<Nz>> ;
ELSEIF Nz 60 = THEN
      MicroF := InterpXS60 Fmap Cpo :: <<Nz>> ;
ELSEIF Nz 70 = THEN
      MicroF := InterpXS70 Fmap Cpo :: <<Nz>> ;
ELSEIF Nz 80 = THEN
      MicroF := InterpXS80 Fmap Cpo :: <<Nz>> ;
ELSEIF Nz 90 = THEN
      MicroF := InterpXS90 Fmap Cpo :: <<Nz>> ;
ELSEIF Nz 100 = THEN
      MicroF := InterpXS100 Fmap Cpo :: <<Nz>> ;
ELSEIF Nz 110 = THEN
      MicroF := InterpXS110 Fmap Cpo :: <<Nz>> ;
ELSEIF Nz 120 = THEN
      MicroF := InterpXS120 Fmap Cpo :: <<Nz>> ;
ELSEIF Nz 130 = THEN
      MicroF := InterpXS130 Fmap Cpo :: <<Nz>> ;
ELSEIF Nz 140 = THEN
      MicroF := InterpXS140 Fmap Cpo :: <<Nz>> ;
ELSEIF Nz 150 = THEN
      MicroF := InterpXS150 Fmap Cpo :: <<Nz>> ;
ELSEIF Nz 160 = THEN
      MicroF := InterpXS160 Fmap Cpo :: <<Nz>> ;
ELSEIF Nz 170 = THEN
      MicroF := InterpXS170 Fmap Cpo :: <<Nz>> ;
ELSEIF Nz 180 = THEN
      MicroF := InterpXS180 Fmap Cpo :: <<Nz>> ;
ELSEIF Nz 190 = THEN
      MicroF := InterpXS190 Fmap Cpo :: <<Nz>> ;
ELSEIF Nz 200 = THEN
      MicroF := InterpXS200 Fmap Cpo :: <<Nz>> ;
ELSE
  ECHO "ERROR: Nz not supported" ;
ENDIF ;

ECHO "+++ Interpolated cross-sections for iter = " iter ;
MacroF := MicroF :: STEP UP 'MACROLIB' ;

Macro2 Matex := MACINI: Matex MacroF :: FUEL ;
  
*--
* Steady-state diffusion calculation
*--
System := TRIVAA: Macro2 Track ;

IF iter 1 = THEN
  Flux := FLUD: System Track ::
    EDIT 0 ADI 4 ACCE 5 3 ;
ELSE
  Flux := FLUD: Flux System Track ::
    EDIT 0 ;
ENDIF ;

System MacroF Macro2 := DELETE: System MacroF Macro2 ;

GREP: Flux :: GETVAL 'K-EFFECTIVE' 1 >>keff1<< ;
ECHO "+++ Burnup= 0.0 Keff=" keff1 ;

*--
* Power distribution calculation
*--
ECHO "total reactor power=" powi "MW" ;
ECHO "In power at iter = " iter ;
Power Fmap := FLPOW: Fmap Flux Track Matex
            :: EDIT 0 PTOT <<powi>> PRINT DISTR FLUX PRINT DISTR POWER ;

ECHO "Completed Neutronics calculation at iter = " iter ;
END: ;