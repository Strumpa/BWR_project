    PLANE 30 30
    PLANE 31 31
    PLANE 32 32
    PLANE 33 33
    PLANE 34 34
    PLANE 35 35
    PLANE 36 36
    PLANE 37 37
    PLANE 38 38
    PLANE 39 39
    PLANE 40 40
    ;
    !
    NXNAME '01' NYNAME  'A'
    NCOMB 1
    B-ZONE 1

    BTYPE INST-BURN
    INST-BVAL CHAN 0.0

    ADD-PARAM PNAME 'T-FUEL' PARKEY 'TFuel' LOCAL
    ADD-PARAM PNAME 'T-COOL' PARKEY 'TCool' LOCAL
    ADD-PARAM PNAME 'D-COOL' PARKEY 'DCool' LOCAL

    FUEL WEIGHT <<BMass>> <<BMass>> <<BMass>> <<BMass>> <<BMass>>
