    MESHY 0.0 <<pitch>>
    MESHZ 0.0 <<z1>> <<z2>> <<z3>> <<z4>> <<z5>> <<z6>> <<z7>> <<z8>> <<z9>> <<z10>>
            
    MIX
    PLANE 1 1
    PLANE 2 2
    PLANE 3 3
    PLANE 4 4
    PLANE 5 5
    PLANE 6 6
    PLANE 7 7
    PLANE 8 8
    PLANE 9 9
    PLANE 10 10
    ;
