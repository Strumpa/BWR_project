REAL Pfact171 Pfact172 Pfact173 Pfact174 Pfact175 Pfact176 Pfact177 Pfact178 Pfact179 Pfact180 ;
REAL Pfact181 Pfact182 Pfact183 Pfact184 Pfact185 Pfact186 Pfact187 Pfact188 Pfact189 Pfact190 ;
REAL Pfact191 Pfact192 Pfact193 Pfact194 Pfact195 Pfact196 Pfact197 Pfact198 Pfact199 Pfact200 ;


IF Iz1 20.0 = THEN

    GREP: guessPow :: GETVAL 'pform' 1 >>Pfact1<< ;
    GREP: guessPow :: GETVAL 'pform' 2 >>Pfact2<< ;
    GREP: guessPow :: GETVAL 'pform' 3 >>Pfact3<< ;
    GREP: guessPow :: GETVAL 'pform' 4 >>Pfact4<< ;
    GREP: guessPow :: GETVAL 'pform' 5 >>Pfact5<< ;
    GREP: guessPow :: GETVAL 'pform' 6 >>Pfact6<< ;
    GREP: guessPow :: GETVAL 'pform' 7 >>Pfact7<< ;
