* CALL      :  FMAP MATEX := SetFMap MATEX ;                               *
*                                                                          *
****************************************************************************

PARAMETER Fmap Matex guessPow ::
      ::: LINKED_LIST
          Fmap Matex guessPow ; ;
MODULE RESINI: GREP: END: ;
REAL pitch height BMass Iz1 powi ;
:: >>pitch<< >>height<< >>BMass<< >>Iz1<< >>powi<< ; (*BMass = Bundle Mass : mass of UOX in an axial fuel slice*)

REAL z1 z2 z3 z4 z5 z6 z7 z8 z9 z10 ; 
REAL z11 z12 z13 z14 z15 z16 z17 z18 z19 z20 ; 
REAL z21 z22 z23 z24 z25 z26 z27 z28 z29 z30 ; 
