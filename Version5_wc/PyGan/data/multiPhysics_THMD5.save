#!/bin/sh
#
if [ $# = 0 ]
   then
   echo '$$$ ----- multiPhysics_THMD5.save : script begin' 1>&2
   exit 1
fi
echo '$$$ ----- multiPhysics_THMD5.save : script begin'
MACH=`uname -s`
Sysx="`echo $MACH | cut -b -6`"
if [ $Sysx = "CYGWIN" ]; then
   MACH=`uname -o`
elif [ $Sysx = "AIX" ]; then
   MACH=`uname -s`
else
   MACH=`uname -sm | sed 's/[ ]/_/'`
fi

cp -r multiPhysics_THMD5 $1/"$MACH"/
cp -r c2m_files $1/"$MACH"/../data/multiPhysics_THMD5_proc
cp *.c2m $1/"$MACH"/../data/multiPhysics_THMD5_proc/

echo '$$$ ----- multiPhysics_THMD5.save : script finish'
