#!/bin/sh
#
if [ $# = 0 ]
   then
   echo '$$$ ----- GE14_multiPhysics_pyTHM.save : script begin' 1>&2
   exit 1
fi
echo '$$$ ----- GE14_multiPhysics_pyTHM.save : script begin'
MACH=`uname -s`
Sysx="`echo $MACH | cut -b -6`"
if [ $Sysx = "CYGWIN" ]; then
   MACH=`uname -o`
elif [ $Sysx = "AIX" ]; then
   MACH=`uname -s`
else
   MACH=`uname -sm | sed 's/[ ]/_/'`
fi

mkdir DISTR_res
mv Flux*.res DISTR_res/
mv Pdistr.res DISTR_res/
mkdir cle2000_procs
mv *.c2m cle2000_procs/
cp -r cle2000_procs/ $1/data/GE14_multiPhysics_pyTHM_proc/
cp -r DISTR_res ./GE14_multiPhysics_PyGan_DOM
cp -r GE14_multiPhysics_PyGan_DOM $1/"$MACH"/

cp -r DISTR_res ./GE14_multiPhysics_PyGan_DOM_VAN
cp -r GE14_multiPhysics_PyGan_DOM_VAN $1/"$MACH"/

echo '$$$ ----- GE14_multiPhysics_pyTHM.save : script finish'
