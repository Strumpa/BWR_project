**************************************************************************************
** Non-regression test for NOLUMPE + EDP0 implementation for a single BWR pincell.
** Simplified from ATRIUM-10 BWR fuel bundle with 2.4% enriched UOX.
** Coolant is set at 0% void fraction.
** Author : R. Guasch
**************************************************************************************
PROCEDURE assertS ;
MODULE GEO: LIB: G2S: SALT: MCCGT: UTL: USS: ASM: FLU: EVO: GREP: DELETE: ;

LINKED_LIST GEOM GEOM_SSH LIBRARY TRACK TRACK_SSH LIBRARY2 SYS FLUX BURNUP StepList ;
SEQ_BINARY TF_EXC TF_EXC_SSH ;
SEQ_ASCII tdtUOX FIG.ps tdtUOXSSH FIG_SSH.ps ;

STRING Library := "e81d1mt458" ;
REAL Kinf ;

REAL Rgap Rclad pitch := 0.4520 0.5140 1.295 ;
REAL Rcomb1 Rcomb2 Rcomb3 Rcomb4 := 0.313602 0.396678 0.43227 0.4435 ;

INTEGER COMB0101 COMB0102 COMB0103 COMB0104 GAP CLAD COOL := 1 2 3 4 5 6 7 ; !  DISTRIBUTED SELF-SHIELDING 

GEOM := GEO: :: CARCEL 6 
    X- REFL X+ REFL
    Y- REFL Y+ REFL
    SECT 4 6
    RADIUS 0.0 <<Rcomb1>> <<Rcomb2>>
          <<Rcomb3>> <<Rcomb4>> <<Rgap>> <<Rclad>>
    MIX <<COMB0101>> <<COMB0102>> <<COMB0103>> <<COMB0104>>
        <<GAP>> <<CLAD>> 
        <<COOL>> <<COOL>> <<COOL>> <<COOL>>
        <<COOL>> <<COOL>> <<COOL>> <<COOL>> 
        <<COOL>> <<COOL>> <<COOL>> <<COOL>>
    MESHX 0.0 <<pitch>> MESHY 0.0 <<pitch>>
;

GEOM_SSH := GEO: :: CARCEL 6 
    X- REFL X+ REFL
    Y- REFL Y+ REFL
    RADIUS 0.0 <<Rcomb1>> <<Rcomb2>>
               <<Rcomb3>> <<Rcomb4>> <<Rgap>> <<Rclad>>
    MIX <<COMB0101>> <<COMB0102>> <<COMB0103>> <<COMB0104>>
        <<GAP>> <<CLAD>> <<COOL>>
    MESHX 0.0 <<pitch>> MESHY 0.0 <<pitch>>
;


LIBRARY := LIB: ::
  EDIT 1
  NMIX 7    ! MAXIMUM OF MATERIAL MIXTURES
  ANIS 4
  ADED 4 NELAS N4N N2N N3N
  PT
  NOLUMPE ! Exclude energy of lumped isotopes from contribution to parent isotopes H-FACTOR

  DEPL LIB: DRAGON FIL: <<Library>>
  MIXS LIB: DRAGON FIL: <<Library>>

  MIX <<COMB0101>> 900.0
    O16     = O16    4.66705E-02
    U234    = U234   5.15910E-06 1 
    U235    = U235   5.67035E-04 1 
    U238    = U238   2.27631E-02 1
    Pu239   = Pu239  1.0E-15 1
    Pu240   = Pu240  0.0     1
    Pu241   = Pu241  1.0E-15 1
    Pu242   = Pu242  0.0     1
  MIX <<COMB0102>> COMB <<COMB0101>> 1.0
  MIX <<COMB0103>> COMB <<COMB0101>> 1.0
  MIX <<COMB0104>> COMB <<COMB0101>> 1.0

  MIX <<GAP>> 900.0 NOEV
    He4      = He4 1.50456E-04

  MIX <<CLAD>> 600.0 NOEV
    Zr90  = Zr90   2.18317E-02 2
    Zr91  = Zr91   4.76096E-03 2
    Zr92  = Zr92   7.27723E-03 2
    Zr94  = Zr94   7.37482E-03 2
    Zr96  = Zr96   1.18812E-03 2

  MIX <<COOL>> 600.0 NOEV 
    H1      = H1_H2O 4.94546E-02
    O16     = O16    2.47298E-02 
;


INTEGER an2d := 18 ;  ! ANGULAR QUADRATURE PARAMETER
REAL densur := 35.0 ; ! DENSITY OF INTEGRATION LINES CM^-1

INTEGER an2d_SSH := 8 ;
REAL densur_SSH := 15.0 ;

* polar angles for MCCGT:
INTEGER nmu := 4 ;

* size allocation for MCCGT:
INTEGER mcu := 50000 ;

* ---
* FLUX CALC TRACKING
* ---
tdtUOX FIG.ps := G2S: GEOM :: ;

TRACK TF_EXC := SALT: tdtUOX ::
  EDIT 0
  ALLG
  TSPC EQW2 <<an2d>> <<densur>> REND
;

* MOC tracking for main flux calculation
TRACK := MCCGT: TRACK TF_EXC ::
  EDIT 0
  CACB <<nmu>> AAC 80 TMT EPSI 1E-5 MCU <<mcu>>
;

* ---
* SELF-SHIELDING TRACKING
* ---
tdtUOXSSH FIG_SSH.ps := G2S: GEOM_SSH :: ;

TRACK_SSH TF_EXC_SSH := SALT: tdtUOXSSH ::
  EDIT 0
  ALLG
  TSPC <<an2d_SSH>> <<densur_SSH>>
;

StepList := UTL: ::
        CREA
            ListBU 12 = 
                0.0 15.0 30.0 50.0 75.0 150.0 500.0 1000.0 2500.0 5000.0 7500.0 10000.0 
        CREA 
            ListSSH 2 =
                1000.0 15000.0 
;

INTEGER istepNext nstep ;
REAL BUbeg Tbeg ;
REAL BU BUautop := 0.0 0.0 ;
REAL Norm_f2 := 26.5 ; ! SPECIFIC POWER MW/t
REAL BUend Tend := 0. 0. ;
INTEGER istep :=  0 ;
INTEGER iauto :=  1 ;

GREP: StepList :: LENGTH ListBU >>nstep<< ;

ECHO "start burnup loop" ;
WHILE istep nstep < DO

 EVALUATE istep := istep 1 + ;
 ECHO "burnup step: " istep "/" nstep ;
 
 EVALUATE BUbeg Tbeg := BUend Tend ;
 GREP: StepList :: GETVAL 'ListBU' <<istep>> >>BUend<< ;
 EVALUATE Tend := BUend Norm_f2 / ;
 ECHO "Nominal depletion between" Tbeg " and" Tend "days" ;

*----
* USS
*----
  IF istep 1 = THEN
     ECHO ".perform self-shielding at" Tbeg "days" ;
      LIBRARY2 := USS: LIBRARY TRACK_SSH TF_EXC_SSH ::
          EDIT 0 PASS 4
      ;
  ELSE
     GREP: StepList :: GETVAL "ListSSH" <<iauto>> >>BUautop<< ;
     GREP: StepList :: GETVAL "ListBU" <<istep>> >>BU<< ;

     IF BUautop BU = THEN
       ECHO "perform self-shielding at" Tbeg "days" ;
       LIBRARY2 := USS: LIBRARY LIBRARY2 TRACK_SSH TF_EXC_SSH ::
          EDIT 0 PASS 4
       ;
      EVALUATE iauto := iauto 1 + ;
      ECHO "iauto is = " iauto ;
    ENDIF ;
  ENDIF ;

************************************************************************
*  BEGIN MOC FLUX CALCULATION                                          *
************************************************************************
  SYS := ASM: LIBRARY2 TRACK TF_EXC :: ARM EDIT 0 ;   

  IF istep 1 = THEN     
     FLUX := FLU: LIBRARY2 SYS TRACK TF_EXC :: 
     EDIT 1 TYPE K ;
  ELSE
     FLUX := FLU: FLUX LIBRARY2 SYS TRACK TF_EXC :: 
     EDIT 1 TYPE K ;
  ENDIF ;
 
  SYS := DELETE: SYS ;

  IF istep 1 = THEN
    BURNUP LIBRARY2 := EVO: LIBRARY2 FLUX TRACK ::
      EDIT 1
      SAVE <<Tbeg>> DAY POWR <<Norm_f2>> EDP0
    ;
  ELSE
    BURNUP LIBRARY2 := EVO: BURNUP LIBRARY2 FLUX TRACK ::
      EDIT 1
      SAVE <<Tbeg>> DAY POWR <<Norm_f2>> EDP0
    ;
  ENDIF ;

  GREP: StepList :: GETVAL "ListBU" <<istep>> >>BU<< ;

  GREP: FLUX :: GETVAL 'K-INFINITY  ' 1 1 1 >>Kinf<< ;
  ECHO "+++ Burnup=" BUend " Kinf=" Kinf " at step" istep ;

  IF istep nstep < THEN
    EVALUATE istepNext := istep 1 + ;
    GREP: StepList :: GETVAL 'ListBU' <<istepNext>> >>BUend<< ;
    EVALUATE Tend := BUend Norm_f2 / ;
  
    BURNUP LIBRARY2 := EVO: BURNUP LIBRARY2 FLUX TRACK ::
     EDIT 1 DEPL <<Tbeg>> <<Tend>> DAY 
     POWR <<Norm_f2>> 
     EXTR
     EDP0 ;
  
  ENDIF ;
 
************************************************************************
*  END FLUX CALCULATION                                                *
************************************************************************

ENDWHILE ;

assertS FLUX :: 'K-EFFECTIVE' 1  1.063875 ;